[Unit]
Description=Hatchtower – watch for update requests from the web interface

[Path]
# Die Weboberfläche (ohne Root-Rechte) legt diese Datei ab, wenn ein Owner „Update installieren“ drückt.
PathExists=/var/lib/hatchtower/update.request
Unit=hatchtower-update.service

[Install]
WantedBy=multi-user.target
