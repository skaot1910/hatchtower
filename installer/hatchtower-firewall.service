[Unit]
Description=Hatchtower – allow the port only for listed IPs (own nftables table)
After=network-pre.target
Before=hatchtower.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/hatchtower/firewall.nft
ExecStop=/usr/sbin/nft delete table inet hatchtower

[Install]
WantedBy=multi-user.target
