[Unit]
Description=Hatchtower – daily database backup

[Service]
Type=oneshot
User=hatchtower
ExecStart=/bin/sh -c 'test -f /var/lib/hatchtower/hatchtower.db && sqlite3 /var/lib/hatchtower/hatchtower.db ".backup /var/backups/hatchtower/hatchtower-$(date +%%F).db"; find /var/backups/hatchtower -maxdepth 1 -name "hatchtower-*.db" -mtime +14 -delete'
