#!/usr/bin/env bash
# Hatchtower – Befehl auf dem Server (als root).
#   hatchtower setup-token | create-owner | reset-password | selftest | version
#   hatchtower support [--full] [datei]   Support-Bericht schreiben (ohne Keys, Passwörter, Tokens), mit Dienst-
#                                     status und Systemprotokoll – die Datei an den schicken, der beim Problem hilft.
#                                     Adressen werden durch Platzhalter ersetzt; --full lässt sie stehen
#   hatchtower update                 neueste Version von GitHub laden und installieren
#                                     (Vorab-Versionen nur mit dem Schalter unter System → Updates
#                                      oder HATCHTOWER_PRERELEASES=1; =0 schaltet sie für diesen Aufruf ab)
#   hatchtower update --check         nur nachsehen, ob es eine neue Version gibt
#   hatchtower update <paket.tar.gz>  ein vorhandenes Paket installieren
#   hatchtower github-token [--remove]   Lese-Token hinterlegen (nur für ein privates Repository nötig)
set -euo pipefail
APP_DIR=/opt/hatchtower
ENV_FILE=/etc/hatchtower/hatchtower.env
TOKEN_STORE=/etc/hatchtower/github-token

need_root() { [ "$(id -u)" -eq 0 ] || { echo "Please run as root."; exit 1; }; }
repo() { sed -n 's/^HATCHTOWER_REPO=//p' "$ENV_FILE" 2>/dev/null | tail -1; }

if [ "${1:-}" = "update" ]; then
  need_root
  SRC="${2:-${HATCHTOWER_UPDATE_URL:-}}"
  # Ohne Paketangabe: neueste Version von GitHub (mit Prüfsumme)
  if [ -z "$SRC" ] || [ "$SRC" = "--check" ]; then
    export HATCHTOWER_REPO="${HATCHTOWER_REPO:-$(repo)}"
    [ -n "$HATCHTOWER_REPO" ] || unset HATCHTOWER_REPO
    if [ "$SRC" = "--check" ]; then exec bash "$APP_DIR/installer/get.sh" --check; fi
    exec bash "$APP_DIR/installer/get.sh" --update
  fi
  WORK="$(mktemp -d /tmp/hatchtower-update.XXXX)"
  trap 'rm -rf "$WORK"' EXIT
  case "$SRC" in
    http://*|https://*) echo "Downloading $SRC"; curl -fsSL "$SRC" -o "$WORK/paket.tar.gz";;
    *) cp "$SRC" "$WORK/paket.tar.gz";;
  esac
  tar -xzf "$WORK/paket.tar.gz" -C "$WORK"
  DIR="$(find "$WORK" -mindepth 1 -maxdepth 1 -type d -name 'hatchtower*' | head -1)"
  [ -n "$DIR" ] && [ -f "$DIR/installer/install.sh" ] || { echo "The package does not contain Hatchtower."; exit 1; }
  echo "Installed: $(cat $APP_DIR/VERSION 2>/dev/null || echo ?)  →  new: $(cat "$DIR/VERSION")"
  exec bash "$DIR/installer/install.sh" --update
fi

# Vom Dienst hatchtower-update.service aufgerufen, wenn in der Weboberfläche „Update installieren“
# gedrückt wurde (die Oberfläche selbst hat keine Root-Rechte und legt nur eine Anfrage-Datei ab).
if [ "${1:-}" = "run-update-request" ]; then
  need_root
  DATA=/var/lib/hatchtower
  # Die Anfrage liegt im Datenordner (dort darf der Dienst schreiben). Status und Protokoll schreibt root
  # nur in einen eigenen Ordner, den der Dienst bloß lesen kann – so kann kein Symlink root umleiten.
  STATUS=/var/lib/hatchtower-update
  REQ="$DATA/update.request"; STATE="$STATUS/update.state"; LOG="$STATUS/update.log"
  [ -f "$REQ" ] || [ -L "$REQ" ] || exit 0
  rm -f "$REQ"
  install -d -o root -g hatchtower -m 750 "$STATUS"
  FROM="$(cat "$APP_DIR/VERSION" 2>/dev/null || echo ?)"
  STARTED="$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
  write_state() {
    printf 'state=%s\nfrom=%s\nto=%s\nstarted=%s\nfinished=%s\n' "$1" "$FROM" "${2:-}" "$STARTED" "${3:-}" > "$STATE.tmp"
    chown root:hatchtower "$STATE.tmp"; chmod 640 "$STATE.tmp"; mv -f "$STATE.tmp" "$STATE"
  }
  install -m 640 -o root -g hatchtower /dev/null "$LOG"
  write_state running
  export HATCHTOWER_REPO="${HATCHTOWER_REPO:-$(repo)}"
  [ -n "$HATCHTOWER_REPO" ] || unset HATCHTOWER_REPO
  if bash "$APP_DIR/installer/get.sh" --update >>"$LOG" 2>&1; then
    write_state "done" "$(cat "$APP_DIR/VERSION" 2>/dev/null)" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
  else
    write_state failed "" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
  fi
  exit 0
fi

if [ "${1:-}" = "github-token" ]; then
  need_root
  if [ "${2:-}" = "--remove" ]; then
    rm -f "$TOKEN_STORE"; echo "GitHub token removed."; exit 0
  fi
  REPO="$(repo)"; REPO="${REPO:-skaot1910/hatchtower}"
  echo "Enter a read token for $REPO (not shown while typing, Enter to cancel):"
  read -rs TOKEN || true   # auch ohne Zeilenumbruch am Ende (z. B. aus einer Pipe)
  echo
  TOKEN="$(printf '%s' "$TOKEN" | tr -d ' \r\n')"
  [ -n "$TOKEN" ] || { echo "Cancelled."; exit 1; }
  code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" \
         -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$REPO" || echo 000)
  [ "$code" = "200" ] || { echo "The token was not accepted (HTTP $code). Nothing was stored."; exit 1; }
  umask 077
  printf '%s\n' "$TOKEN" > "$TOKEN_STORE"
  chown root:hatchtower "$TOKEN_STORE"; chmod 640 "$TOKEN_STORE"
  echo "Stored. From now on \"hatchtower update\" gets new versions directly from GitHub."
  exit 0
fi

# Support report: the report itself runs as the service user; root adds service status and system journal (the
# service user cannot read them), and everything goes through the same redaction of secrets before it is written.
if [ "${1:-}" = "support" ]; then
  need_root
  shift
  FULL=0
  if [ "${1:-}" = "--full" ]; then FULL=1; shift; fi
  OUT="${1:-$PWD/hatchtower-support-$(date +%Y-%m-%d_%H-%M).txt}"
  export HATCHTOWER_SUPPORT_ADDRESSES=$FULL
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a
  cd "$APP_DIR/app"
  export HOME=/var/lib/hatchtower
  PY=(setpriv --reuid=hatchtower --regid=hatchtower --init-groups "$APP_DIR/venv/bin/python" -m hatchtower.cli)
  line="=============================================================================="
  umask 077
  {
    "${PY[@]}" support 2>&1 || echo "!! The report itself failed – the journal below shows why."
    printf '\n%s\n14. Service status\n%s\n' "$line" "$line"
    systemctl status 'hatchtower*' --no-pager -n 0 2>&1 | head -60 || true
    printf '\n%s\n15. System journal of the Hatchtower services (repeated messages once, with count)\n%s\n' "$line" "$line"
    journalctl -u 'hatchtower*' -n 3000 --no-pager -o short-iso 2>&1 || true
  } | "${PY[@]}" redact > "$OUT"
  echo "Support report written: $OUT"
  echo "Please send this file to whoever helps you. It contains no keys, passwords or tokens."
  [ "$FULL" = 1 ] || echo "Addresses are replaced by placeholders; \"hatchtower support --full\" keeps them."
  exit 0
fi

set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a
cd "$APP_DIR/app"
export HOME=/var/lib/hatchtower
exec setpriv --reuid=hatchtower --regid=hatchtower --init-groups "$APP_DIR/venv/bin/python" -m hatchtower.cli "$@"
